{
  "name": "dni-print",
  "private": true,
  "version": "1.2.0",
  "description": "Imprimí tu DNI a tamaño real desde el navegador, sin enviar datos.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "make:icons": "node scripts/make-icons.ts",
    "check:dist": "node scripts/check-dist-urls.ts",
    "check:seo": "node scripts/check-dist-seo.ts",
    "check:engine": "node scripts/check-dist-engine.ts",
    "check:precache": "node scripts/check-dist-precache.ts",
    "compare-engines": "node scripts/compare-engines.ts",
    "check:licenses": "node scripts/check-licenses.ts",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@techstark/opencv-js": "5.0.0-release.1",
    "comlink": "4.4.2",
    "jspdf": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "scanic": "1.8.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1"
  }
}
